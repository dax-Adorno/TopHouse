# ============================================================
# ENTORNO GENERAL
# ============================================================

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================
# BACKEND
# ============================================================

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace_with_a_secure_random_value
SESSION_DURATION_HOURS=12
# Usar false únicamente durante desarrollo local sin HTTPS.
SESSION_COOKIE_SECURE=false
# Hosts HTTP aceptados por la API, separados por coma y sin esquema.
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# FRONTEND
# ============================================================

FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=tophouse
POSTGRES_USER=tophouse
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://tophouse:replace_with_a_secure_password@db:5432/tophouse

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:5173

# ============================================================
# OBJECT STORAGE S3-COMPATIBLE
# ============================================================

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tophouse-properties
S3_REGION=auto
S3_USE_SSL=true
# URL pública del CDN, sin barra final. Vacía conserva URLs firmadas de S3.
S3_PUBLIC_BASE_URL=
